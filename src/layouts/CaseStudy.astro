---
// Shared shell for long-form case-study pages. Reuses the site Layout (SEO, fonts, smooth scroll).
import Layout from './Layout.astro';
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}
const { title, description, eyebrow = 'Case study' } = Astro.props;
---
<Layout title={`${title} | Sandeep Malviya`} description={description}>
  <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-3 font-mono text-xs uppercase tracking-[0.14em]">
      <a href="/" class="text-slate-700 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600">&larr; Back to portfolio</a>
      <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-slate-900">CV &nearr;</a>
    </div>
  </header>
  <article class="case-study mx-auto max-w-3xl px-6 pb-24 pt-14">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-blue-600">{eyebrow}</p>
    <h1 class="mt-3 text-balance text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">{title}</h1>
    <slot />
    <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-600">
      <p>
        Questions or want a walkthrough? <a href="mailto:sandy.competent@gmail.com">Email me</a> or find me on{' '}
        <a href="https://www.linkedin.com/in/sandeep-malviya-ml/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.{' '}
        <a href="/">Back to the portfolio</a>.
      </p>
    </footer>
  </article>
</Layout>
<style is:global>
  .case-study { color: #1e293b; font-size: 1.0625rem; line-height: 1.7; }
  .case-study h2 { margin-top: 2.75rem; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.01em; color: #0f172a; }
  .case-study h3 { margin-top: 1.75rem; font-size: 1.125rem; font-weight: 700; color: #0f172a; }
  .case-study p, .case-study ul, .case-study ol, .case-study .table-wrap { margin-top: 1rem; }
  .case-study .lede { font-size: 1.25rem; color: #334155; }
  .case-study ul { list-style: disc; padding-left: 1.4rem; }
  .case-study ol { list-style: decimal; padding-left: 1.4rem; }
  .case-study li { margin-top: 0.4rem; }
  .case-study a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 3px; }
  .case-study a:hover { color: #1e3a8a; }
  .case-study code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.9em; background: #f1f5f9; border-radius: 4px; padding: 0.1em 0.35em; }
  .case-study .table-wrap { overflow-x: auto; }
  .case-study table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .case-study caption { text-align: left; font-weight: 600; color: #475569; padding-bottom: 0.4rem; }
  .case-study th, .case-study td { border: 1px solid #e2e8f0; padding: 0.55rem 0.75rem; text-align: left; vertical-align: top; }
  .case-study thead th { background: #f8fafc; color: #0f172a; }
  .case-study .note { margin-top: 1.25rem; border-left: 4px solid #f59e0b; background: #fffbeb; padding: 0.85rem 1rem; border-radius: 0 8px 8px 0; color: #78350f; }
</style>
