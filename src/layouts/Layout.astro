---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sandeep | Software & Agentic AI Engineer',
  description = 'Bridging four years of high-performance mobile architecture with autonomous machine learning. Data Science MSc (Distinction) | University of Exeter.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="font-sans antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sandeep Malviya" />
    <meta name="theme-color" content="#f8fafc" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://sandeepmalviya.me/" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased selection:bg-blue-500/20 selection:text-blue-500">
    <main id="smooth-wrapper" class="relative min-h-screen w-full transition-none">
      <div id="smooth-content" class="relative w-full">
        <slot />
      </div>
    </main>

    <style is:global>
      :root {
        --bg-primary: #f8fafc;
        --text-primary: #0f172a;
        --text-muted: #475569;
        --border-color: rgba(15, 23, 42, 0.08);
        --pivot-glow-opacity: 0;
      }

      #smooth-wrapper {
        background-color: var(--bg-primary);
        color: var(--text-primary);
      }
    </style>

    <script>
      import Lenis from '@studio-freight/lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const lenisOptions = {
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical' as const,
        gestureOrientation: 'vertical' as const,
        smoothWheel: true,
        smoothTouch: true,
        syncTouch: true,
        touchMultiplier: 1.8,
      };

      const lenis = new Lenis(lenisOptions as ConstructorParameters<typeof Lenis>[0]);

      // Synchronize Lenis scroll events with GSAP ScrollTrigger
      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // Expose lenis globally for anchor navigation
      (window as unknown as { __lenis?: Lenis }).__lenis = lenis;

      // Smooth anchor scrolling via Lenis
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const targetId = anchor.getAttribute('href');
          if (!targetId || targetId === '#') return;
          const targetEl = document.querySelector<HTMLElement>(targetId);
          if (targetEl) {
            e.preventDefault();
            lenis.scrollTo(targetEl, { offset: 0, duration: 1.4 });
          }
        });
      });

      // Ensure ScrollTrigger recalculates pin positions after fonts/layout settle
      window.addEventListener('load', () => {
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
