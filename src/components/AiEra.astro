---
// Section 4 - The AI & ML Frontier (light theme)
---

<section
  id="ai-frontier"
  class="relative w-full overflow-hidden bg-white py-28 text-slate-900 sm:py-36"
  aria-labelledby="ai-frontier-heading"
>
  <!-- Subtle Blueprint Architectural Grid Background -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(15,23,42,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.035)_1px,transparent_1px)] bg-[size:4.5rem_4.5rem]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-40 right-1/4 h-96 w-96 rounded-full bg-blue-400/10 blur-[140px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Section Header -->
    <div class="ai-reveal mb-20 max-w-3xl">
      <div class="mb-4 inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.22em] text-blue-600">
        <span class="h-2 w-2 rounded-full bg-blue-600"></span>
        <span>02 // Autonomous Intelligence &amp; Neural Systems</span>
      </div>
      <h2
        id="ai-frontier-heading"
        class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl"
      >
        The AI Frontier
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
        Architecting autonomous multi-agent workflows, low-latency neuro-telemetry pipelines, and
        first-principles deep learning models.
      </p>
    </div>

    <!-- AI & ML Cards Grid -->
    <div class="space-y-12">
      <!-- Block 1: Agentic AI Engineer @ University of Exeter -->
      <article
        class="ai-reveal group relative overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-300 hover:border-blue-300 hover:shadow-[0_20px_50px_rgb(15,23,42,0.07)] sm:p-12"
      >
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3.5 py-1 font-mono text-xs font-medium text-blue-700"
              >
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-blue-600"></span>
                Aug 2026 - Present
              </span>
              <span
                class="rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 font-mono text-xs text-slate-700"
              >
                University of Exeter
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              Agentic AI Engineer @ University of Exeter
            </h3>

            <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
              Currently building intelligent, autonomous AI agents for university-wide deployment,
              bridging my heavy software engineering background with advanced machine learning.
            </p>

            <div class="mt-7 flex flex-wrap gap-2.5 font-mono text-xs">
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-blue-700">
                Autonomous Agent Orchestration
              </span>
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-700">
                Tool-Use &amp; RAG Pipelines
              </span>
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-700">
                Enterprise AI Deployment
              </span>
            </div>

            <!-- Real project links -->
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a
                href="https://github.com/SandyCompetent/exeter_academic_agent"
                target="_blank"
                rel="noopener noreferrer"
                class="group/link inline-flex items-center gap-2 rounded-lg bg-slate-900 px-3.5 py-1.5 font-mono text-xs font-medium text-white transition-all hover:-translate-y-0.5 hover:bg-slate-800"
              >
                View Repository
                <span class="transition-transform duration-200 group-hover/link:translate-x-0.5" aria-hidden="true">&nearr;</span>
              </a>
              <a
                href="https://sandycompetent.github.io/exeter_academic_agent/"
                target="_blank"
                rel="noopener noreferrer"
                class="group/link inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-mono text-xs font-medium text-slate-900 transition-all hover:-translate-y-0.5 hover:border-slate-900"
              >
                Live Demo
                <span class="transition-transform duration-200 group-hover/link:translate-x-0.5" aria-hidden="true">&nearr;</span>
              </a>
            </div>
          </div>

          <!-- Agentic Loop Telemetry Visual -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-slate-200 bg-slate-50/90 p-6 font-mono text-xs">
              <div class="flex items-center justify-between border-b border-slate-200 pb-3 text-slate-500">
                <span>AGENT_RUNTIME // EXETER_CORE</span>
                <span class="text-blue-600">ACTIVE</span>
              </div>
              <div class="mt-4 space-y-3">
                <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3.5 py-2.5">
                  <span class="text-slate-700">01. Planner &amp; Intent Router</span>
                  <span class="text-emerald-600">OK</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-blue-200 bg-blue-50 px-3.5 py-2.5">
                  <span class="text-blue-800">02. Autonomous Tool Execution</span>
                  <span class="animate-pulse text-blue-600">RUNNING</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3.5 py-2.5">
                  <span class="text-slate-700">03. Verification &amp; Guardrails</span>
                  <span class="text-indigo-600">READY</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Block 2: Mobile Engineer (BLE & AI) @ Marbles Health -->
      <article
        class="ai-reveal group relative overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-300 hover:border-indigo-300 hover:shadow-[0_20px_50px_rgb(15,23,42,0.07)] sm:p-12"
      >
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1 font-mono text-xs font-medium text-indigo-700"
              >
                Jan 2024 - Aug 2025
              </span>
              <span
                class="rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 font-mono text-xs text-slate-700"
              >
                NeuroTech // BLE Hardware &amp; Python
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              Mobile Engineer (BLE &amp; AI) @ Marbles Health
            </h3>

            <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
              Engineered a core BLE communication layer connecting a hardware headband to read live EEG
              and tDCS brain signals. Plotted real-time data onto a doctor-facing interface and wrote
              Python scripts to stress-test the data pipeline.
            </p>

            <div class="mt-7 flex flex-wrap gap-2.5 font-mono text-xs">
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-indigo-700">
                Low-Latency BLE GATT Stream
              </span>
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-700">
                Live EEG &amp; tDCS Telemetry
              </span>
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-700">
                Python Stress-Testing Suite
              </span>
            </div>
          </div>

          <!-- Real-Time EEG / tDCS Waveform Telemetry Card -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-slate-200 bg-slate-50/90 p-6">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-slate-500">EEG / tDCS STREAM</span>
                <span class="text-indigo-600">250 Hz // BLE GATT</span>
              </div>
              <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 bg-white p-4">
                <svg
                  class="h-24 w-full text-indigo-500"
                  viewBox="0 0 400 100"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path
                    d="M0 50 L30 50 L45 20 L60 80 L75 35 L90 65 L110 50 L145 50 L160 12 L175 88 L190 28 L205 70 L225 50 L265 50 L280 18 L295 82 L310 38 L325 62 L345 50 L400 50"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                  <path
                    d="M0 75 Q 50 60, 100 75 T 200 75 T 300 75 T 400 75"
                    stroke="#60a5fa"
                    stroke-width="1.2"
                    stroke-dasharray="4 4"
                    opacity="0.75"></path>
                </svg>
              </div>
              <div class="mt-3 flex justify-between font-mono text-[11px] text-slate-500">
                <span>CH1: Prefrontal Cortex (Fp1/Fp2)</span>
                <span class="text-emerald-600">Packet Loss &lt; 0.01%</span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Block 3: Academic Research -->
      <article
        class="ai-reveal group relative overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-300 hover:border-emerald-300 hover:shadow-[0_20px_50px_rgb(15,23,42,0.07)] sm:p-12"
      >
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1 font-mono text-xs font-medium text-emerald-700"
              >
                Deep Learning Research
              </span>
              <span
                class="rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 font-mono text-xs text-slate-700"
              >
                Technical Lead (Team of 4)
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              Academic Research
            </h3>

            <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
              Engineered a Convolutional Neural Network (CNN) entirely from scratch for hand sign
              recognition without relying on 3rd party black-box models. Led the core technical
              architecture for a team of 4.
            </p>

            <div class="mt-7 flex flex-wrap gap-2.5 font-mono text-xs">
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-emerald-700">
                Zero Black-Box Pretrained Weights
              </span>
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-700">
                Custom Spatial Feature Extraction
              </span>
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-700">
                Multi-Class Gesture Classification
              </span>
            </div>
          </div>

          <!-- Custom CNN Architecture Schematic -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-slate-200 bg-slate-50/90 p-6 font-mono text-xs">
              <div class="flex items-center justify-between border-b border-slate-200 pb-3 text-slate-500">
                <span>CNN_TENSOR_GRAPH</span>
                <span class="text-emerald-600">FROM SCRATCH</span>
              </div>
              <div class="mt-4 grid grid-cols-4 gap-2 text-center text-[10px]">
                <div class="rounded-lg border border-slate-200 bg-white p-2.5">
                  <span class="block text-slate-500">Input</span>
                  <span class="mt-1 block font-semibold text-slate-900">RGB Frame</span>
                </div>
                <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-2.5">
                  <span class="block text-emerald-600">Conv2D</span>
                  <span class="mt-1 block font-semibold text-slate-900">ReLU + Pool</span>
                </div>
                <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-2.5">
                  <span class="block text-emerald-600">Dropout</span>
                  <span class="mt-1 block font-semibold text-slate-900">Dense FC</span>
                </div>
                <div class="rounded-lg border border-blue-200 bg-blue-50 p-2.5">
                  <span class="block text-blue-600">Output</span>
                  <span class="mt-1 block font-semibold text-slate-900">Softmax</span>
                </div>
              </div>
              <p class="mt-4 text-[11px] leading-relaxed text-slate-500">
                Architected custom forward/backward spatial hierarchies &amp; led pipeline integration across 4 researchers.
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const aiItems = document.querySelectorAll('.ai-reveal');
  aiItems.forEach((item) => {
    if (prefersReducedMotion) return;
    gsap.fromTo(
      item,
      { opacity: 0, y: 48 },
      {
        opacity: 1,
        y: 0,
        duration: 0.95,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
      }
    );
  });
</script>
