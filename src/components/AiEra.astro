---
// Phase 5: Section 4 - The AI & ML Frontier
---

<section
  id="ai-frontier"
  class="relative w-full overflow-hidden bg-zinc-950 py-28 text-slate-200 sm:py-36"
  aria-labelledby="ai-frontier-heading"
>
  <!-- Ambient Neon Grid & Glowing Backdrop -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(56,189,248,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(56,189,248,0.04)_1px,transparent_1px)] bg-[size:4.5rem_4.5rem]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-40 right-1/4 h-96 w-96 rounded-full bg-cyan-500/10 blur-[140px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-10 left-1/4 h-96 w-96 rounded-full bg-indigo-600/10 blur-[140px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Section Header -->
    <div class="ai-reveal mb-20 max-w-3xl">
      <div class="mb-4 inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.22em] text-cyan-400">
        <span class="h-2 w-2 rounded-full bg-cyan-400 shadow-[0_0_10px_#22d3ee]"></span>
        <span>02 // Autonomous Intelligence &amp; Neural Systems</span>
      </div>
      <h2
        id="ai-frontier-heading"
        class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl"
      >
        The AI Frontier
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-400 sm:text-lg">
        Architecting autonomous multi-agent workflows, low-latency neuro-telemetry pipelines, and
        first-principles deep learning models.
      </p>
    </div>

    <!-- AI & ML Cards Grid -->
    <div class="space-y-12">
      <!-- Block 1: Agentic AI Engineer @ University of Exeter (Aug 2026 - Present) -->
      <article
        class="ai-reveal group relative overflow-hidden rounded-3xl border border-zinc-800/90 bg-zinc-900/60 p-8 shadow-[0_0_50px_-15px_rgba(34,211,238,0.12)] backdrop-blur-xl transition-all duration-300 hover:border-cyan-500/40 hover:shadow-[0_0_60px_-10px_rgba(34,211,238,0.22)] sm:p-12"
      >
        <!-- Top Neon Highlight Bar -->
        <div
          class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/70 to-transparent"
          aria-hidden="true"
        >
        </div>

        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3.5 py-1 font-mono text-xs font-medium text-cyan-300"
              >
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
                Aug 2026 - Present
              </span>
              <span
                class="rounded-full border border-zinc-700 bg-zinc-800/80 px-3.5 py-1 font-mono text-xs text-slate-300"
              >
                University of Exeter
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-bold tracking-tight text-white sm:text-3xl">
              Agentic AI Engineer @ University of Exeter (Aug 2026 - Present)
            </h3>

            <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
              Currently building intelligent, autonomous AI agents for university-wide deployment,
              bridging my heavy software engineering background with advanced machine learning.
            </p>

            <div class="mt-7 flex flex-wrap gap-2.5 font-mono text-xs">
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-cyan-300">
                Autonomous Agent Orchestration
              </span>
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-slate-300">
                Tool-Use &amp; RAG Pipelines
              </span>
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-slate-300">
                Enterprise AI Deployment
              </span>
            </div>
          </div>

          <!-- Agentic Loop Telemetry Visual -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-zinc-800 bg-zinc-950/90 p-6 font-mono text-xs">
              <div class="flex items-center justify-between border-b border-zinc-800 pb-3 text-slate-400">
                <span>AGENT_RUNTIME // EXETER_CORE</span>
                <span class="text-cyan-400">ACTIVE</span>
              </div>
              <div class="mt-4 space-y-3">
                <div class="flex items-center justify-between rounded-xl border border-zinc-800/90 bg-zinc-900/70 px-3.5 py-2.5">
                  <span class="text-slate-300">01. Planner &amp; Intent Router</span>
                  <span class="text-emerald-400">OK</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-cyan-500/30 bg-cyan-950/20 px-3.5 py-2.5">
                  <span class="text-cyan-200">02. Autonomous Tool Execution</span>
                  <span class="animate-pulse text-cyan-400">RUNNING</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-zinc-800/90 bg-zinc-900/70 px-3.5 py-2.5">
                  <span class="text-slate-300">03. Verification &amp; Guardrails</span>
                  <span class="text-indigo-400">READY</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Block 2: Mobile Engineer (BLE & AI) @ Marbles Health (Jan 2024 - Aug 2025) -->
      <article
        class="ai-reveal group relative overflow-hidden rounded-3xl border border-zinc-800/90 bg-zinc-900/60 p-8 shadow-[0_0_50px_-15px_rgba(99,102,241,0.12)] backdrop-blur-xl transition-all duration-300 hover:border-indigo-500/40 hover:shadow-[0_0_60px_-10px_rgba(99,102,241,0.22)] sm:p-12"
      >
        <div
          class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-indigo-400/70 to-transparent"
          aria-hidden="true"
        >
        </div>

        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-1 font-mono text-xs font-medium text-indigo-300"
              >
                Jan 2024 - Aug 2025
              </span>
              <span
                class="rounded-full border border-zinc-700 bg-zinc-800/80 px-3.5 py-1 font-mono text-xs text-slate-300"
              >
                NeuroTech // BLE Hardware &amp; Python
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-bold tracking-tight text-white sm:text-3xl">
              Mobile Engineer (BLE &amp; AI) @ Marbles Health (Jan 2024 - Aug 2025)
            </h3>

            <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
              Engineered a core BLE communication layer connecting a hardware headband to read live EEG
              and tDCS brain signals. Plotted real-time data onto a doctor-facing interface and wrote
              Python scripts to stress-test the data pipeline.
            </p>

            <div class="mt-7 flex flex-wrap gap-2.5 font-mono text-xs">
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-indigo-300">
                Low-Latency BLE GATT Stream
              </span>
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-slate-300">
                Live EEG &amp; tDCS Telemetry
              </span>
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-slate-300">
                Python Stress-Testing Suite
              </span>
            </div>
          </div>

          <!-- Real-Time EEG / tDCS Waveform Telemetry Card -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-zinc-800 bg-zinc-950/90 p-6">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-slate-400">EEG / tDCS STREAM</span>
                <span class="text-indigo-400">250 Hz // BLE GATT</span>
              </div>
              <div class="mt-4 overflow-hidden rounded-xl border border-zinc-800/80 bg-zinc-900/50 p-4">
                <svg
                  class="h-24 w-full text-indigo-400"
                  viewBox="0 0 400 100"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path
                    d="M0 50 L30 50 L45 20 L60 80 L75 35 L90 65 L110 50 L145 50 L160 12 L175 88 L190 28 L205 70 L225 50 L265 50 L280 18 L295 82 L310 38 L325 62 L345 50 L400 50"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                  <path
                    d="M0 75 Q 50 60, 100 75 T 200 75 T 300 75 T 400 75"
                    stroke="#22d3ee"
                    stroke-width="1.2"
                    stroke-dasharray="4 4"
                    opacity="0.65"></path>
                </svg>
              </div>
              <div class="mt-3 flex justify-between font-mono text-[11px] text-slate-500">
                <span>CH1: Prefrontal Cortex (Fp1/Fp2)</span>
                <span class="text-emerald-400">Packet Loss &lt; 0.01%</span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Block 3: Academic Research -->
      <article
        class="ai-reveal group relative overflow-hidden rounded-3xl border border-zinc-800/90 bg-zinc-900/60 p-8 shadow-[0_0_50px_-15px_rgba(16,185,129,0.1)] backdrop-blur-xl transition-all duration-300 hover:border-emerald-500/40 hover:shadow-[0_0_60px_-10px_rgba(16,185,129,0.2)] sm:p-12"
      >
        <div
          class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-emerald-400/70 to-transparent"
          aria-hidden="true"
        >
        </div>

        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 font-mono text-xs font-medium text-emerald-300"
              >
                Deep Learning Research
              </span>
              <span
                class="rounded-full border border-zinc-700 bg-zinc-800/80 px-3.5 py-1 font-mono text-xs text-slate-300"
              >
                Technical Lead (Team of 4)
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-bold tracking-tight text-white sm:text-3xl">
              Academic Research
            </h3>

            <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
              Engineered a Convolutional Neural Network (CNN) entirely from scratch for hand sign
              recognition without relying on 3rd party black-box models. Led the core technical
              architecture for a team of 4.
            </p>

            <div class="mt-7 flex flex-wrap gap-2.5 font-mono text-xs">
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-emerald-300">
                Zero Black-Box Pretrained Weights
              </span>
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-slate-300">
                Custom Spatial Feature Extraction
              </span>
              <span class="rounded-lg border border-zinc-800 bg-zinc-950/80 px-3 py-1.5 text-slate-300">
                Multi-Class Gesture Classification
              </span>
            </div>
          </div>

          <!-- Custom CNN Architecture Schematic -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-zinc-800 bg-zinc-950/90 p-6 font-mono text-xs">
              <div class="flex items-center justify-between border-b border-zinc-800 pb-3 text-slate-400">
                <span>CNN_TENSOR_GRAPH</span>
                <span class="text-emerald-400">FROM SCRATCH</span>
              </div>
              <div class="mt-4 grid grid-cols-4 gap-2 text-center text-[10px]">
                <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-2.5">
                  <span class="block text-slate-400">Input</span>
                  <span class="mt-1 block font-semibold text-white">RGB Frame</span>
                </div>
                <div class="rounded-lg border border-emerald-500/30 bg-emerald-950/20 p-2.5">
                  <span class="block text-emerald-400">Conv2D</span>
                  <span class="mt-1 block font-semibold text-white">ReLU + Pool</span>
                </div>
                <div class="rounded-lg border border-emerald-500/30 bg-emerald-950/20 p-2.5">
                  <span class="block text-emerald-400">Dropout</span>
                  <span class="mt-1 block font-semibold text-white">Dense FC</span>
                </div>
                <div class="rounded-lg border border-cyan-500/30 bg-cyan-950/20 p-2.5">
                  <span class="block text-cyan-400">Output</span>
                  <span class="mt-1 block font-semibold text-white">Softmax</span>
                </div>
              </div>
              <p class="mt-4 text-[11px] leading-relaxed text-slate-400">
                Architected custom forward/backward spatial hierarchies &amp; led pipeline integration across 4 researchers.
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const aiItems = document.querySelectorAll('.ai-reveal');
  aiItems.forEach((item) => {
    gsap.fromTo(
      item,
      { opacity: 0, y: 48 },
      {
        opacity: 1,
        y: 0,
        duration: 0.95,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
      }
    );
  });
</script>
