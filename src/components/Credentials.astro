---
// Section: Academic Honours & Industry Certifications (light theme)
interface Degree {
  degree: string;
  institution: string;
  period: string;
  honour: string;
  dissertation: string;
  modules?: string[];
}

interface Certification {
  title: string;
  issuer: string;
  date: string;
  credentialId?: string;
  url?: string;
  highlight: string;
}

const degrees: Degree[] = [
  {
    degree: 'Master of Science (MSc) in Data Science',
    institution: 'University of Exeter',
    period: 'Sep 2024 – Sep 2025',
    honour: 'Graduated with Distinction',
    dissertation: 'Stock return prediction using hybrid deep neural networks and FinBERT sentiment analysis.',
    modules: ['Machine Learning', 'Data Systems', 'Python Programming', 'Applied Analytics'],
  },
  {
    degree: 'Bachelor of Engineering (BE) in Computer Engineering',
    institution: 'G.H. Raisoni College of Engineering, Pune',
    period: '2017 – 2022',
    honour: 'First Class with Distinction',
    dissertation: 'Hand sign recognition Convolutional Neural Network (CNN) built from first principles.',
  },
];

const certifications: Certification[] = [
  {
    title: 'Introduction to Model Context Protocol',
    issuer: 'Anthropic',
    date: 'Aug 2026',
    credentialId: 'xxpvk3z4mqaa',
    url: 'https://verify.skilljar.com/c/xxpvk3z4mqaa',
    highlight: 'Advanced MCP client-host architecture, dynamic tool exposure, and LLM context protocols.',
  },
  {
    title: 'Python Teaching Certificate',
    issuer: 'Google Developer Student Club Exeter',
    date: 'Nov 2024',
    url: 'https://www.linkedin.com/in/sandeep-malviya-ml',
    highlight: 'Taught core programming, data structures, recursion, and clean code principles to STEM undergraduates.',
  },
  {
    title: 'Data Analytics & Visualization Job Simulation',
    issuer: 'Accenture North America / Forage',
    date: 'Nov 2024',
    credentialId: 'ETviFLYL2ezEez4ZJ',
    highlight: 'Exploratory data analysis, stakeholder storytelling, and enterprise data modelling simulations.',
  },
];
---

<section
  id="credentials"
  class="relative w-full overflow-hidden bg-white py-24 text-slate-900 sm:py-32"
  aria-labelledby="credentials-heading"
>
  <!-- Blueprint Grid -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(15,23,42,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.035)_1px,transparent_1px)] bg-[size:4rem_4rem]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Header -->
    <div class="cred-reveal mb-16 max-w-3xl">
      <div class="mb-4 inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.22em] text-blue-600">
        <span class="h-2 w-2 rounded-full bg-blue-600"></span>
        <span>04 // Academic Honours &amp; Certifications</span>
      </div>
      <h2 id="credentials-heading" class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Education &amp; Credentials
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
        Rigorous computer engineering foundations validated by distinction-level research and official industry credentials.
      </p>
    </div>

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Degrees column -->
      <div class="space-y-6 lg:col-span-6">
        <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
          Formal Degrees &amp; Research
        </h3>

        {degrees.map((d) => (
          <article class="cred-reveal group relative rounded-2xl border border-slate-200/90 bg-slate-50/70 p-6 shadow-sm transition-all duration-300 hover:border-slate-300 hover:bg-white hover:shadow-md sm:p-8">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-full bg-blue-50 px-3 py-1 font-mono text-xs font-semibold text-blue-700">
                {d.honour}
              </span>
              <span class="font-mono text-xs text-slate-500">{d.period}</span>
            </div>

            <h4 class="mt-4 text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
              {d.degree}
            </h4>
            <p class="mt-1 font-mono text-xs font-medium text-slate-600">
              {d.institution}
            </p>

            <div class="mt-4 rounded-xl border border-slate-200/80 bg-white p-4 text-sm text-slate-600">
              <span class="font-mono text-xs font-semibold text-slate-900">Dissertation: </span>
              {d.dissertation}
            </div>

            {d.modules && (
              <div class="mt-4 flex flex-wrap gap-2 font-mono text-[11px]">
                {d.modules.map((m) => (
                  <span class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-slate-600">
                    {m}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>

      <!-- Certifications column -->
      <div class="space-y-6 lg:col-span-6">
        <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
          Industry Accreditations
        </h3>

        <div class="space-y-4">
          {certifications.map((c) => (
            <article class="cred-reveal group relative flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-6 shadow-sm transition-all duration-300 hover:border-blue-300 hover:shadow-md">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="font-mono text-xs font-semibold text-blue-600">
                    {c.issuer}
                  </span>
                  <span class="font-mono text-xs text-slate-400">{c.date}</span>
                </div>

                <h4 class="mt-2 text-lg font-bold tracking-tight text-slate-900">
                  {c.title}
                </h4>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">
                  {c.highlight}
                </p>
              </div>

              <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
                {c.credentialId ? (
                  <span class="font-mono text-[11px] text-slate-400">
                    ID: {c.credentialId}
                  </span>
                ) : (
                  <span class="font-mono text-[11px] text-emerald-600">
                    Verified Instructor
                  </span>
                )}

                {c.url && (
                  <a
                    href={c.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 font-mono text-xs font-medium text-slate-700 transition-colors hover:text-blue-600"
                  >
                    Verify Certificate &nearr;
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const credItems = document.querySelectorAll('.cred-reveal');
  credItems.forEach((item) => {
    if (prefersReducedMotion) return;
    gsap.fromTo(
      item,
      { opacity: 0, y: 36 },
      {
        opacity: 1,
        y: 0,
        duration: 0.85,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 88%',
          toggleActions: 'play none none reverse',
        },
      }
    );
  });
</script>
