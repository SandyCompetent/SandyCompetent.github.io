---
// Section 5 - Skills Grid & Footer (light theme)
const skills = [
  { name: 'Python', tag: 'AI / Deep Learning', dot: 'bg-blue-500', delay: '0s' },
  { name: 'Flutter & Dart', tag: 'Production Mobile', dot: 'bg-cyan-500', delay: '0.5s' },
  { name: 'Agentic AI', tag: 'MCP & Multi-Agent', dot: 'bg-indigo-500', delay: '1.0s' },
  { name: 'SQL & Postgres', tag: 'Data Engineering', dot: 'bg-sky-500', delay: '1.5s' },
  { name: 'Cloud & Docker', tag: 'GCP / DevOps / CI', dot: 'bg-amber-500', delay: '2.0s' },
];
---

<footer
  id="contact"
  class="relative w-full overflow-hidden border-t border-slate-200 bg-slate-50 pt-24 pb-16 text-slate-900 sm:pt-32 sm:pb-24"
  aria-label="Core Technologies and Contact"
>
  <!-- Subtle Blueprint Grid Background -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(15,23,42,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.03)_1px,transparent_1px)] bg-[size:4rem_4rem]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Skills Matrix Section -->
    <div class="footer-reveal text-center">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-blue-600">
        05 // Core Stack Matrix
      </p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Production Arsenal
      </h2>

      <!-- 5 Floating Badges: Python, Flutter & Dart, Agentic AI, SQL, Cloud -->
      <div
        class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-6"
        role="list"
        aria-label="Core Technologies"
      >
        {
          skills.map((skill) => (
            <div
              role="listitem"
              style={`animation-delay: ${skill.delay};`}
              class="skill-badge md:animate-float-badge group relative flex flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-300 last:col-span-2 hover:-translate-y-1 hover:border-slate-300 hover:shadow-[0_20px_50px_rgb(15,23,42,0.07)] sm:last:col-span-1"
            >
              <div class="mb-3 flex items-center gap-2">
                <span class={`h-2 w-2 rounded-full ${skill.dot}`} />
                <span class="font-mono text-[10px] uppercase tracking-widest text-slate-400">
                  {skill.tag}
                </span>
              </div>
              <span class="text-lg font-extrabold tracking-tight text-slate-900 sm:text-xl">
                {skill.name}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Divider -->
    <div class="my-20 h-px w-full bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>

    <!-- Footer Contact (No Forms) -->
    <div class="footer-reveal mx-auto max-w-4xl text-center">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-slate-500">
        Initiate Connection
      </p>

      <h2
        class="mt-5 text-balance text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl"
      >
        Let's build something autonomous.
      </h2>

      <!-- 3 Large Minimalist Buttons -->
      <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:gap-6">
        <a
          href="mailto:sandy.competent@gmail.com"
          class="group flex items-center justify-between rounded-2xl bg-slate-900 px-7 py-6 text-lg font-bold tracking-tight text-white transition-all duration-300 hover:-translate-y-1 hover:bg-slate-800 hover:shadow-[0_20px_50px_rgb(15,23,42,0.12)]"
        >
          <span>Email Me</span>
          <span
            class="font-mono text-xl transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            &nearr;
          </span>
        </a>

        <a
          href="https://github.com/SandyCompetent"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-2xl border border-slate-300 bg-white px-7 py-6 text-lg font-bold tracking-tight text-slate-900 transition-all duration-300 hover:-translate-y-1 hover:border-slate-900 hover:shadow-[0_20px_50px_rgb(15,23,42,0.08)]"
        >
          <span>GitHub</span>
          <span
            class="font-mono text-xl text-slate-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-slate-900"
            aria-hidden="true"
          >
            &nearr;
          </span>
        </a>

        <a
          href="https://www.linkedin.com/in/sandeep-malviya-ml"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-2xl border border-slate-300 bg-white px-7 py-6 text-lg font-bold tracking-tight text-slate-900 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500 hover:shadow-[0_20px_50px_rgb(15,23,42,0.08)]"
        >
          <span>LinkedIn</span>
          <span
            class="font-mono text-xl text-slate-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-blue-600"
            aria-hidden="true"
          >
            &nearr;
          </span>
        </a>
      </div>
    </div>

    <!-- Bottom Colophon -->
    <div
      class="mt-20 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-8 font-mono text-xs text-slate-500 sm:flex-row"
    >
      <p>&copy; {new Date().getFullYear()} Sandeep Malviya. Engineered with Astro, Tailwind, GSAP &amp; Lenis.</p>
      <a
        href="#hero"
        class="inline-flex items-center gap-2 text-slate-500 transition-colors hover:text-blue-600"
      >
        <span>Back to Top</span>
        <span aria-hidden="true">&uarr;</span>
      </a>
    </div>
  </div>
</footer>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const footerBlocks = document.querySelectorAll('.footer-reveal');
  footerBlocks.forEach((block) => {
    if (prefersReducedMotion) return;
    gsap.fromTo(
      block,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: block,
          start: 'top 88%',
          toggleActions: 'play none none reverse',
        },
      }
    );
  });
</script>
