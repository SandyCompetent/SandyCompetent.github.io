---
// Phase 6: Section 5 - Skills Grid & Footer
const skills = [
  {
    name: 'Python',
    tag: 'AI / Deep Learning',
    glow: 'hover:border-cyan-400/60 hover:shadow-[0_0_35px_-5px_rgba(34,211,238,0.35)]',
    dot: 'bg-cyan-400 shadow-[0_0_10px_#22d3ee]',
    delay: '0s',
  },
  {
    name: 'SQL',
    tag: 'Data Engineering',
    glow: 'hover:border-blue-400/60 hover:shadow-[0_0_35px_-5px_rgba(96,165,250,0.35)]',
    dot: 'bg-blue-400 shadow-[0_0_10px_#60a5fa]',
    delay: '0.6s',
  },
  {
    name: 'Flutter',
    tag: 'Cross-Platform UI',
    glow: 'hover:border-sky-400/60 hover:shadow-[0_0_35px_-5px_rgba(56,189,248,0.35)]',
    dot: 'bg-sky-400 shadow-[0_0_10px_#38bdf8]',
    delay: '1.2s',
  },
  {
    name: 'AWS',
    tag: 'Cloud Infrastructure',
    glow: 'hover:border-amber-400/60 hover:shadow-[0_0_35px_-5px_rgba(251,191,36,0.35)]',
    dot: 'bg-amber-400 shadow-[0_0_10px_#fbbf24]',
    delay: '1.8s',
  },
  {
    name: 'Docker',
    tag: 'Container Runtime',
    glow: 'hover:border-indigo-400/60 hover:shadow-[0_0_35px_-5px_rgba(129,140,248,0.35)]',
    dot: 'bg-indigo-400 shadow-[0_0_10px_#818cf8]',
    delay: '2.4s',
  },
];
---

<footer
  id="contact"
  class="relative w-full overflow-hidden border-t border-zinc-900 bg-zinc-950 pt-24 pb-16 text-slate-200 sm:pt-32 sm:pb-24"
  aria-label="Core Technologies and Contact"
>
  <!-- Ambient Bottom Glow -->
  <div
    class="pointer-events-none absolute bottom-0 left-1/2 h-[28rem] w-[48rem] -translate-x-1/2 rounded-full bg-gradient-to-t from-blue-600/15 via-cyan-500/10 to-transparent blur-[130px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Skills Matrix Section -->
    <div class="footer-reveal text-center">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-cyan-400">
        03 // Core Stack Matrix
      </p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">
        Production Arsenal
      </h2>

      <!-- 5 Glowing & Floating Badges: Python, SQL, Flutter, AWS, Docker -->
      <div
        class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-6"
        role="list"
        aria-label="Core Technologies"
      >
        {
          skills.map((skill) => (
            <div
              role="listitem"
              style={`animation-delay: ${skill.delay};`}
              class={`skill-badge animate-float-badge group relative flex flex-col items-center justify-center rounded-2xl border border-zinc-800/90 bg-zinc-900/70 px-6 py-7 shadow-[0_0_25px_-10px_rgba(56,189,248,0.15)] backdrop-blur-xl transition-all duration-300 last:col-span-2 sm:last:col-span-1 ${skill.glow}`}
            >
              <div class="mb-3 flex items-center gap-2">
                <span class={`h-2 w-2 rounded-full ${skill.dot}`} />
                <span class="font-mono text-[10px] uppercase tracking-widest text-slate-400">
                  {skill.tag}
                </span>
              </div>
              <span class="text-xl font-extrabold tracking-tight text-white sm:text-2xl">
                {skill.name}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Divider -->
    <div class="my-20 h-px w-full bg-gradient-to-r from-transparent via-zinc-800 to-transparent"></div>

    <!-- Footer Contact (No Forms) -->
    <div class="footer-reveal mx-auto max-w-4xl text-center">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-slate-400">
        Initiate Connection
      </p>

      <h2
        class="mt-5 text-balance text-4xl font-extrabold tracking-tight text-white sm:text-6xl"
      >
        Let's build something autonomous.
      </h2>

      <!-- 3 Large Minimalist Buttons -->
      <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:gap-6">
        <a
          href="mailto:sandy.competent@gmail.com"
          class="group flex items-center justify-between rounded-2xl border border-zinc-800 bg-white px-7 py-6 text-lg font-bold tracking-tight text-zinc-950 transition-all duration-300 hover:-translate-y-1 hover:bg-cyan-300 hover:shadow-[0_0_40px_rgba(34,211,238,0.35)]"
        >
          <span>Email Me</span>
          <span
            class="font-mono text-xl transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            &nearr;
          </span>
        </a>

        <a
          href="https://github.com/SandyCompetent"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-2xl border border-zinc-800 bg-zinc-900/80 px-7 py-6 text-lg font-bold tracking-tight text-white backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-zinc-600 hover:bg-zinc-800/90 hover:shadow-[0_0_35px_rgba(255,255,255,0.08)]"
        >
          <span>GitHub</span>
          <span
            class="font-mono text-xl text-slate-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-white"
            aria-hidden="true"
          >
            &nearr;
          </span>
        </a>

        <a
          href="https://www.linkedin.com/in/sandeep-malviya-ml"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-2xl border border-zinc-800 bg-zinc-900/80 px-7 py-6 text-lg font-bold tracking-tight text-white backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/50 hover:bg-zinc-800/90 hover:shadow-[0_0_35px_rgba(34,211,238,0.18)]"
        >
          <span>LinkedIn</span>
          <span
            class="font-mono text-xl text-slate-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-cyan-400"
            aria-hidden="true"
          >
            &nearr;
          </span>
        </a>
      </div>
    </div>

    <!-- Bottom Colophon -->
    <div
      class="mt-20 flex flex-col items-center justify-between gap-4 border-t border-zinc-900/90 pt-8 font-mono text-xs text-slate-500 sm:flex-row"
    >
      <p>&copy; {new Date().getFullYear()} Sandeep Malviya. Engineered with Astro, Tailwind, GSAP &amp; Lenis.</p>
      <a
        href="#hero"
        class="inline-flex items-center gap-2 text-slate-400 transition-colors hover:text-cyan-400"
      >
        <span>Back to Top</span>
        <span aria-hidden="true">&uarr;</span>
      </a>
    </div>
  </div>
</footer>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const footerBlocks = document.querySelectorAll('.footer-reveal');
  footerBlocks.forEach((block) => {
    gsap.fromTo(
      block,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: block,
          start: 'top 88%',
          toggleActions: 'play none none reverse',
        },
      }
    );
  });
</script>
