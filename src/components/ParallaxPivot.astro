---
// Phase 4: Section 3 - The Parallax Pivot (Transition Zone)
---

<section
  id="parallax-pivot"
  class="relative flex min-h-screen w-full flex-col items-center justify-center overflow-hidden px-6 py-24"
  style="background-color: var(--bg-primary); color: var(--text-primary);"
  aria-label="Academic Pivot to Data Science and AI"
>
  <!-- Ambient Neural Glow & Dark Contrast Core that fades in as theme transitions to zinc-950 -->
  <div
    id="pivot-glow"
    class="pointer-events-none absolute inset-0 opacity-0"
    aria-hidden="true"
  >
    <div
      class="absolute left-1/2 top-1/2 h-[30rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-zinc-950/90 blur-[90px]"
    >
    </div>
    <div
      class="absolute left-1/2 top-1/2 h-[32rem] w-[32rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-tr from-blue-600/25 via-indigo-500/20 to-cyan-400/20 blur-[120px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(56,189,248,0.08)_0%,transparent_65%)]"
    >
    </div>
  </div>

  <!-- Concentric Orbital Rings (Parallax Visual Anchor) -->
  <div
    id="pivot-rings"
    class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
    aria-hidden="true"
  >
    <div
      class="h-[22rem] w-[22rem] rounded-full border border-current opacity-[0.07] sm:h-[34rem] sm:w-[34rem]"
    >
    </div>
    <div
      class="absolute inset-8 rounded-full border border-dashed border-current opacity-[0.09]"
    >
    </div>
  </div>

  <!-- Center Pivot Content -->
  <div id="pivot-content" class="relative z-10 mx-auto max-w-5xl text-center">
    <div
      id="pivot-badge"
      class="mb-8 inline-flex items-center gap-3 rounded-full border px-4 py-1.5 font-mono text-xs uppercase tracking-[0.22em]"
      style="border-color: var(--border-color); color: var(--text-muted);"
    >
      <span class="h-2 w-2 rounded-full bg-cyan-400 shadow-[0_0_12px_#22d3ee]"></span>
      <span>The Paradigm Shift // Russell Group Excellence</span>
    </div>

    <h2
      id="pivot-headline"
      class="text-balance text-4xl font-extrabold tracking-tight sm:text-6xl md:text-7xl lg:leading-[1.08]"
      style="color: var(--text-primary);"
    >
      Data Science MSc (Distinction) | University of Exeter
    </h2>

    <p
      id="pivot-subtext"
      class="mx-auto mt-8 max-w-2xl text-xl font-medium tracking-tight sm:text-2xl md:text-3xl"
      style="color: var(--text-muted);"
    >
      Moving from the interface to the intelligence.
    </p>

    <!-- Scrub Progress Indicator -->
    <div class="mx-auto mt-14 flex max-w-xs flex-col items-center gap-3">
      <div class="flex w-full justify-between font-mono text-[10px] uppercase tracking-[0.2em] opacity-60">
        <span>01. Interface (Light)</span>
        <span>02. Intelligence (Dark)</span>
      </div>
      <div class="h-1 w-full overflow-hidden rounded-full bg-slate-500/20">
        <div
          id="pivot-progress-bar"
          class="h-full w-full origin-left scale-x-0 rounded-full bg-gradient-to-r from-blue-500 via-indigo-400 to-cyan-400"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const pivotSection = document.getElementById('parallax-pivot');
  const smoothWrapper = document.getElementById('smooth-wrapper');
  const pivotGlow = document.getElementById('pivot-glow');
  const pivotContent = document.getElementById('pivot-content');
  const pivotRings = document.getElementById('pivot-rings');
  const pivotHeadline = document.getElementById('pivot-headline');
  const pivotProgressBar = document.getElementById('pivot-progress-bar');

  if (pivotSection && smoothWrapper) {
    const colorTargets = [smoothWrapper, document.documentElement];

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: pivotSection,
        start: 'top top',
        end: '+=120%',
        pin: true,
        scrub: 0.5,
        anticipatePin: 1,
        refreshPriority: 1,
        invalidateOnRefresh: true,
      },
    });

    // 1a. Scrub background color rapidly into deep slate by 40% scroll, then settle into zinc-950 (#09090b)
    tl.fromTo(
      colorTargets,
      { '--bg-primary': '#f8fafc' },
      { '--bg-primary': '#0f172a', ease: 'power2.in', duration: 0.42 },
      0
    ).to(
      colorTargets,
      { '--bg-primary': '#09090b', ease: 'none', duration: 0.58 },
      0.42
    );

    // 1b. Hold dark text while background is still light, then invert crisp light typography as background plunges dark
    tl.fromTo(
      colorTargets,
      {
        '--text-primary': '#0f172a',
        '--text-muted': '#475569',
        '--border-color': 'rgba(15, 23, 42, 0.08)',
      },
      {
        '--text-primary': '#0f172a',
        '--text-muted': '#334155',
        '--border-color': 'rgba(15, 23, 42, 0.12)',
        ease: 'none',
        duration: 0.24,
      },
      0
    )
      .to(
        colorTargets,
        {
          '--text-primary': '#f8fafc',
          '--text-muted': '#cbd5e1',
          '--border-color': 'rgba(255, 255, 255, 0.16)',
          ease: 'power2.out',
          duration: 0.18,
        },
        0.24
      )
      .to(
        colorTargets,
        {
          '--text-primary': '#f8fafc',
          '--text-muted': '#94a3b8',
          '--border-color': 'rgba(255, 255, 255, 0.14)',
          ease: 'none',
          duration: 0.58,
        },
        0.42
      );

    // 2. Fade in neural dark-mode glow & rotate orbital rings
    if (pivotGlow) {
      tl.fromTo(
        pivotGlow,
        { opacity: 0 },
        { opacity: 1, ease: 'power2.out', duration: 0.65 },
        0.15
      );
    }

    if (pivotRings) {
      tl.fromTo(
        pivotRings,
        { scale: 0.85, rotate: 0 },
        { scale: 1.15, rotate: 45, ease: 'none', duration: 1 },
        0
      );
    }

    // 3. Scale and illuminate Exeter MSc typography
    if (pivotContent) {
      tl.fromTo(
        pivotContent,
        { scale: 0.92, y: 18 },
        { scale: 1.03, y: 0, ease: 'power2.out', duration: 1 },
        0
      );
    }

    if (pivotHeadline) {
      tl.fromTo(
        pivotHeadline,
        { textShadow: '0 0 0px rgba(56, 189, 248, 0)' },
        { textShadow: '0 0 42px rgba(56, 189, 248, 0.28)', ease: 'none', duration: 0.7 },
        0.3
      );
    }

    if (pivotProgressBar) {
      tl.fromTo(
        pivotProgressBar,
        { scaleX: 0 },
        { scaleX: 1, ease: 'none', duration: 1 },
        0
      );
    }
  }
</script>
