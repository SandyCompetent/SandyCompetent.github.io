---
// Section: Featured open-source work — flagship agent + data science repos (light theme).
// Metadata is fetched from the GitHub API at BUILD TIME (refreshes on every deploy),
// with real values baked in as fallback so a GitHub outage never breaks the build.

interface RepoMeta {
  pushed_at?: string;
  stargazers_count?: number;
  language?: string;
  license?: string | null;
}

async function fetchRepo(name: string): Promise<RepoMeta | null> {
  try {
    const res = await fetch(`https://api.github.com/repos/SandyCompetent/${name}`, {
      headers: {
        Accept: 'application/vnd.github+json',
        'User-Agent': 'sandeepmalviya.me-build',
      },
    });
    if (!res.ok) return null;
    const d = await res.json();
    return {
      pushed_at: d.pushed_at,
      stargazers_count: d.stargazers_count,
      language: d.language,
      license: d.license?.spdx_id ?? null,
    };
  } catch {
    return null;
  }
}

function monthYear(iso?: string): string | null {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}

type Project = {
  name: string;
  repo: string;
  slug: string;
  demo?: string;
  blurb: string;
  stack: string[];
  accent: 'blue' | 'indigo' | 'emerald';
  featured?: boolean;
  fallback: Required<RepoMeta>;
};

const projects: Project[] = [
  {
    name: 'ChatBud — Multi-Agent Workspace & Grounded RAG Platform',
    repo: 'https://github.com/SandyCompetent/chatbud',
    slug: 'chatbud',
    demo: 'https://chatbud-official.web.app',
    blurb:
      'A stateful multi-agent messaging workspace built with Flutter 3.33+ and Firebase AI (Gemini 2.5 / 2.0). Features an on-device Grounded RAG engine with live verified citations to eliminate hallucinations, 16 curated agent personas, encrypted local vector memory vault (pure Dart cosine similarity), and a 100-query automated LLM evaluation suite (100% pass rate).',
    stack: ['Flutter 3.33+', 'Firebase AI', 'Gemini 2.5', 'Grounded RAG', 'Vector Memory Vault'],
    accent: 'blue',
    featured: true,
    fallback: { pushed_at: '2026-10-24T00:37:00Z', stargazers_count: 1, language: 'Dart', license: 'MIT' },
  },
  {
    name: 'Stock Market AI — Multimodal Forecasting Platform',
    repo: 'https://github.com/SandyCompetent/stock-market-analysis',
    slug: 'stock-market-analysis',
    demo: 'https://stock-market-analysis-sandy.streamlit.app/',
    blurb:
      'End-to-end multimodal predictive platform fusing quantitative technical indicators (RSI, MACD, Bollinger Bands, Moving Averages, OBV) with daily aggregated financial news sentiment extracted via FinBERT. Achieved 69.2% directional market prediction accuracy (+4.3% over baselines) across LSTM, GRU, SVR, and ARIMA models with an interactive Streamlit simulation dashboard.',
    stack: ['Python', 'PyTorch', 'FinBERT', 'LSTM / GRU', 'Streamlit'],
    accent: 'emerald',
    fallback: { pushed_at: '2026-10-24T17:17:58Z', stargazers_count: 1, language: 'Python', license: 'MIT' },
  },
  {
    name: 'Exeter Academic Agent — Conversational Assistant',
    repo: 'https://github.com/SandyCompetent/exeter_academic_agent',
    slug: 'exeter_academic_agent',
    demo: 'https://sandycompetent.github.io/exeter_academic_agent/',
    blurb:
      'Intelligent conversational assistant powered by Google Gemini 2.5 API with sub-second time-to-first-token streaming, dynamic multi-tool routing for live campus library seat availability, Stagecoach bus schedules, and staff contact directories.',
    stack: ['Dart', 'Flutter', 'Gemini 2.5', 'Tool Routing', 'MCP'],
    accent: 'blue',
    fallback: { pushed_at: '2026-03-19T10:44:33Z', stargazers_count: 0, language: 'Dart', license: 'MIT' },
  },
  {
    name: 'FinPal — Shared Finance & Debt Simplification',
    repo: 'https://github.com/SandyCompetent/finpal',
    slug: 'finpal',
    blurb:
      'Cross-platform shared expense and bill-splitting platform featuring a graph-based debt simplification algorithm to minimize transaction volume across multi-party settlements. Built with a responsive Flutter client (iOS/Android/Web) and high-throughput FastAPI backend with PostgreSQL and Redis.',
    stack: ['Flutter', 'FastAPI', 'Python', 'PostgreSQL', 'Redis', 'Docker'],
    accent: 'emerald',
    fallback: { pushed_at: '2026-10-14T16:00:00Z', stargazers_count: 0, language: 'Dart', license: null },
  },
  {
    name: 'Secure e-Voting System',
    repo: 'https://github.com/SandyCompetent/evoting-system',
    slug: 'evoting-system',
    demo: 'https://evoting-system.freehosting.dev',
    blurb:
      'Production-hardened digital ballot web application engineered with layered Domain/Service/Repository architecture. Features database-enforced UNIQUE(voter_id, category_id) double-voting prevention, Argon2id password hashing, CSRF security, and a CLI test runner with 56 unit tests & 142 assertions.',
    stack: ['PHP 8+', 'MySQL', 'Bootstrap 5', 'Argon2id', 'Unit Testing'],
    accent: 'indigo',
    fallback: { pushed_at: '2026-10-23T12:45:00Z', stargazers_count: 0, language: 'PHP', license: null },
  },
  {
    name: 'Kaggle Analysis Showcase',
    repo: 'https://github.com/SandyCompetent/kaggle_analysis_showcase',
    slug: 'kaggle_analysis_showcase',
    blurb:
      'End-to-end data science projects turning real Kaggle datasets into interactive Streamlit web apps across the full workflow — exploratory data analysis (EDA), automated feature engineering, model tuning, and deployment.',
    stack: ['Python', 'Pandas', 'Scikit-learn', 'Streamlit', 'Matplotlib'],
    accent: 'indigo',
    fallback: { pushed_at: '2025-08-25T22:12:40Z', stargazers_count: 0, language: 'Jupyter Notebook', license: 'MIT' },
  },
];

const resolved = await Promise.all(
  projects.map(async (p) => {
    const live = await fetchRepo(p.slug);
    const meta = live ?? p.fallback;
    return {
      ...p,
      meta: {
        updated: monthYear(meta.pushed_at ?? p.fallback.pushed_at),
        stars: meta.stargazers_count ?? 0,
        language: meta.language ?? p.fallback.language,
        license: meta.license ?? p.fallback.license,
      },
    };
  })
);

const flagship = resolved.find((p) => p.featured)!;
const rest = resolved.filter((p) => !p.featured);

const accentMap = {
  blue: { text: 'text-blue-600', border: 'hover:border-blue-300', bar: 'via-blue-400/60' },
  indigo: { text: 'text-indigo-600', border: 'hover:border-indigo-300', bar: 'via-indigo-400/60' },
  emerald: { text: 'text-emerald-600', border: 'hover:border-emerald-300', bar: 'via-emerald-400/60' },
};
const cardShadow = 'shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_50px_rgb(15,23,42,0.07)]';
---

<section
  id="projects"
  class="relative w-full overflow-hidden bg-slate-50 py-28 text-slate-900 sm:py-36"
  aria-labelledby="projects-heading"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(15,23,42,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.03)_1px,transparent_1px)] bg-[size:4rem_4rem]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <!-- Section Header -->
    <div class="ds-reveal mb-16 max-w-3xl">
      <div class="mb-4 inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.22em] text-blue-600">
        <span class="h-2 w-2 rounded-full bg-blue-600"></span>
        <span>03 // Featured Work</span>
      </div>
      <h2 id="projects-heading" class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Open-Source Projects
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
        Shipping agents and reproducible analytics in the open &mdash; from Gemini-powered assistants to deployed data apps.
      </p>
    </div>

    <!-- Flagship card (full width) -->
    <article
      class={`ds-reveal group relative mb-6 flex flex-col overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-8 ${cardShadow} transition-all duration-300 sm:p-10 ${accentMap[flagship.accent].border}`}
    >
      <div class={`pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent ${accentMap[flagship.accent].bar} to-transparent`} aria-hidden="true"></div>

      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-8">
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3.5 py-1 font-mono text-xs font-medium text-blue-700">
              <span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>
              Flagship Platform
            </span>
            <span class="rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 font-mono text-xs text-slate-700">
              Live Demo &amp; Code
            </span>
          </div>

          <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            {flagship.name}
          </h3>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
            {flagship.blurb}
          </p>

          <div class="mt-6 flex flex-wrap gap-2 font-mono text-[11px]">
            {flagship.stack.map((s) => (
              <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700">{s}</span>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[11px] text-slate-500">
            {flagship.meta.language && (
              <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-blue-500"></span>{flagship.meta.language}</span>
            )}
            {flagship.meta.updated && <span>Updated {flagship.meta.updated}</span>}
            {flagship.meta.license && <span>{flagship.meta.license}</span>}
            {flagship.meta.stars > 0 && <span class="inline-flex items-center gap-1">&#9733; {flagship.meta.stars}</span>}
          </div>
        </div>

        <!-- CTA cluster -->
        <div class="flex flex-col gap-3 lg:col-span-4">
          <a
            href={flagship.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3.5 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md"
          >
            Open Live Demo
            <span aria-hidden="true">&nearr;</span>
          </a>
          <a
            href={flagship.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-slate-900 hover:text-slate-900 hover:shadow-sm"
          >
            View Repository
            <span aria-hidden="true">&nearr;</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Secondary project grid -->
    <div class="grid gap-6 md:grid-cols-2">
      {
        rest.map((p) => {
          const a = accentMap[p.accent];
          return (
            <article
              class={`ds-reveal group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-8 ${cardShadow} transition-all duration-300 ${a.border}`}
            >
              <div class={`pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent ${a.bar} to-transparent`} aria-hidden="true" />
              <div>
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 font-mono text-[11px] text-slate-700">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                    {p.meta.language}
                  </span>
                  <div class="flex items-center gap-3">
                    {p.demo && (
                      <a
                        href={p.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`inline-flex items-center gap-1 font-mono text-xs font-semibold ${a.text} hover:underline`}
                      >
                        Demo <span aria-hidden="true">&nearr;</span>
                      </a>
                    )}
                    <a
                      href={p.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-mono text-xs font-medium text-slate-500 hover:text-slate-900 hover:underline"
                    >
                      Repo <span aria-hidden="true">&nearr;</span>
                    </a>
                  </div>
                </div>

                <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900">{p.name}</h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">{p.blurb}</p>

                <div class="mt-6 flex flex-wrap gap-2 font-mono text-[11px]">
                  {p.stack.map((s) => (
                    <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700">{s}</span>
                  ))}
                </div>
              </div>

              <div class="mt-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-slate-200 pt-4 font-mono text-[11px] text-slate-500">
                <div class="flex items-center gap-3">
                  {p.meta.updated && <span>Updated {p.meta.updated}</span>}
                  {p.meta.license && <span>{p.meta.license}</span>}
                  {p.meta.stars > 0 && <span class="inline-flex items-center gap-1">&#9733; {p.meta.stars}</span>}
                </div>
                <div class="flex items-center gap-2">
                  {p.demo && (
                    <a
                      href={p.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-lg bg-slate-900 px-3 py-1.5 font-mono text-[11px] font-semibold text-white transition-all hover:bg-slate-800"
                    >
                      Live Demo &nearr;
                    </a>
                  )}
                  <a
                    href={p.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 font-mono text-[11px] font-medium text-slate-700 transition-colors hover:border-slate-400 hover:text-slate-900"
                  >
                    GitHub &nearr;
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="ds-reveal mt-10 text-center">
      <a
        href="https://github.com/SandyCompetent?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-slate-500 transition-colors hover:text-blue-600"
      >
        View all repositories on GitHub
        <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dsItems = document.querySelectorAll('.ds-reveal');
  dsItems.forEach((item) => {
    if (prefersReducedMotion) return;
    gsap.fromTo(
      item,
      { opacity: 0, y: 44 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 88%',
          toggleActions: 'play none none reverse',
        },
      }
    );
  });
</script>
