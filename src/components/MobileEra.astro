<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Scroll-triggered fade-up reveal for MobileEra blocks
  const mobileItems = document.querySelectorAll('.mobile-reveal');
  mobileItems.forEach((item) => {
    gsap.fromTo(
      item,
      { opacity: 0, y: 44 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 86%',
          toggleActions: 'play none none reverse',
        },
      }
    );
  });

  // Carousel prev/next buttons for BlockPay FinTech screenshots with wrap-around support
  const track = document.getElementById('blockpay-carousel-track');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');

  if (track && prevBtn && nextBtn) {
    const step = 309;
    prevBtn.addEventListener('click', () => {
      if (track.scrollLeft <= 4) {
        track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: -step, behavior: 'smooth' });
      }
    });
    nextBtn.addEventListener('click', () => {
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step, behavior: 'smooth' });
      }
    });
  }
</script>
